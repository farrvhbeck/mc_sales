# Nusxa oling:  cp .env.example .env   va to'ldiring.
# .env hech qachon git'ga tushmaydi (.gitignore da).

# https://console.groq.com/keys  -> Create API Key
GROQ_API_KEY=
# Limitlar AKKAUNT boshiga (1000 so'rov/kun, 8000 token/daqiqa).
# Boshqa akkauntdan key qo'shsangiz limit shuncha barobar oshadi.
# Ixtiyoriy, xohlagancha qo'shish mumkin:
GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Telegram: @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=
# Chat ID: botga bir marta yozing, keyin oching:
#   https://api.telegram.org/bot<TOKEN>/getUpdates   -> result[0].message.chat.id
TELEGRAM_CHAT_ID=
